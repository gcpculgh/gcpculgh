{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gcpculgh-zip-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "gcpcul-media"
    }
  ]
}   