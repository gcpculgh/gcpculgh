{
  "version": 2,
  "buildCommand": "bash vercel_build.sh",
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "gcpcul/wsgi.py"
    }
  ],
  "functions": {
    "gcpcul/wsgi.py": {
      "excludeFiles": "{static/**,gcpcul/media/**,og-generator/**,docs/**,tests/**,**/__pycache__/**,**/*.pyc,*.sqlite3,db.sqlite3,**/django_summernote/static/**,**/botocore/data/**}"
    }
  }
}   