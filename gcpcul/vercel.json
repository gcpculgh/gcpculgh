{
  "version": 2,
  "builds": [
    {
      "src": "gcpcul/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "gcpcul/wsgi.py"
    }
  ],
  "functions": {
    "gcpcul/wsgi.py": {
      "excludeFiles": "{**/botocore/data/sagemaker/**,**/botocore/data/ec2/**,**/botocore/data/rds/**,**/botocore/data/glue/**,**/botocore/data/quicksight/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}