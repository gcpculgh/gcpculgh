{
  "version": 2,
  "builds": [
    {
      "src": "gcpcul/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "gcpcul/wsgi.py"
    }
  ],
  "functions": {
    "gcpcul/wsgi.py": {
      "excludeFiles": [
        "_vendor/botocore/data/sagemaker/**",
        "_vendor/botocore/data/ec2/**",
        "_vendor/botocore/data/rds/**",
        "_vendor/botocore/data/glue/**",
        "_vendor/botocore/data/quicksight/**",
        "**/*.pyc",
        "**/__pycache__/**",
        "db.sqlite3",
        "media/**"
      ]
    }
  }
}