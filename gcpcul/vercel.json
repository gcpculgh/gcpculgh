{
  "version": 2,
  "builds": [
    {
      "src": "gcpcul/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "gcpcul/wsgi.py"
    }
  ],
  "functions": {
    "gcpcul/wsgi.py": {
      "excludeFiles": [
        "media/**",
        "**/django_summernote/static/**",
        "**/botocore/data/sagemaker/**",
        "**/botocore/data/ec2/**",
        "**/*.pyc",
        "**/__pycache__/**",
        "db.sqlite3"
      ]
    }
  }
}